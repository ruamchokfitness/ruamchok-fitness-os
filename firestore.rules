rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the requesting user is an admin.
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Rules for all collections
    // For this prototype, we allow all authenticated users to read and write
    // to ensure all modules (PT Tracker, Sales, HRM, Audit Log) work correctly.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Specific rules for the 'users' collection to ensure users can read their own profile
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && isAdmin();
    }
  }
}